# Copy to .env and fill in real values. Never commit .env — only this
# .example file (with placeholders) belongs in git.
#
# See backend/README.md's "Auth setup" section for exactly how to obtain
# each of these and which GitHub OAuth App callback URL to register.

# From your GitHub OAuth App's settings page.
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# Random signing key for our own JWTs. Generate one yourself — do not use a
# placeholder in real use. E.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=xxx

# Must exactly match the "Authorization callback URL" registered on the
# GitHub OAuth App — this is the backend's own fixed URL, never the phone's.
# Use whatever host/port the phone's Backend Host setting points at, e.g.:
#   OAUTH_REDIRECT_URI=http://192.168.1.23:8000/auth/github/callback
OAUTH_REDIRECT_URI=http://192.168.1.23:8000/auth/github/callback
