# Copy to .env and set to your PC's LAN IP + the backend's port.
#
# Expo Go runs on your phone, so "localhost" here would mean the phone
# itself, not your PC. Find your PC's LAN IP (e.g. `ipconfig` on Windows,
# look for the Wi-Fi adapter's IPv4 address), make sure the phone is on the
# same Wi-Fi network, and start the backend with:
#   uvicorn main:app --host 0.0.0.0 --port 8000
#
# This is only the default — it can also be changed at runtime from the
# app's Settings screen (persisted on the phone).
EXPO_PUBLIC_BACKEND_HOST=192.168.1.23:8000
